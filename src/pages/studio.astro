---
import Layout from "../layouts/Layout.astro";
import { getEntry, render } from "astro:content";
const page = (await getEntry("pages", "studio"))!;
const story = (await getEntry("pages", "studio-story"))!;
const contact = (await getEntry("pages", "studio-contact"))!;
const { Content: Intro } = await render(page);
const { Content: Story } = await render(story);
const { Content: Contact } = await render(contact);
---
<Layout title={page.data.title} description={page.data.description}>
  <section class="shell page-intro"><span class="eyebrow">{page.data.eyebrow}</span><Intro /></section>
  <section class="shell studio-story"><img src={story.data.image} alt={story.data.imageAlt} /><div><span class="eyebrow">{story.data.eyebrow}</span><Story /></div></section>
  <section class="shell studio-contact"><span class="eyebrow">{contact.data.eyebrow}</span><Contact /></section>
</Layout>
