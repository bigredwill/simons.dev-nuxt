---
import Layout from "../layouts/Layout.astro";
import WorkSelection from "../components/WorkSelection.astro";
---

<Layout description="Simons Development Labs. Objects, software, and experiments by Will Simons.">
  <section class="studio-hero shell">
    <div class="eyebrow hero-top">
      <span>Independent creative practice</span>
      <span>San Francisco, CA ↙</span>
    </div>
    <div class="hero-bottom">
      <p>
        Objects, software, and experiments by Will Simons.
        <br />
        Solo founder of <a href="/projects/skateboard.fyi">skateboard.fyi</a>,
        an archive of skateboard print culture.
      </p>
      <a class="text-link" href="/studio">
        Meet the studio ↗
      </a>
    </div>
  </section>
  <section class="shell selected-section">
    <div class="section-heading">
      <h2>Selected work</h2>
    </div>
    <WorkSelection limit={4} />
    <a class="text-link archive-link" href="/work">
      More from the workbench ↗
    </a>
  </section>
  <section class="studio-update shell">
    <div>
      <span class="eyebrow">In the studio / 01</span>
      <h2>
        What should
        <br />I make next?
      </h2>
    </div>
    <div>
      <p>
        I’m working through STUDIO WORKS, developing an idea into an object that
        could help sustain my creative practice.
      </p>
      <p>
        Right now: looking back through experiments, following the ones that
        still have something to say.
      </p>
      <a class="text-link" href="/notes/studio-works">
        A note from the studio ↗
      </a>
    </div>
  </section>
</Layout>
