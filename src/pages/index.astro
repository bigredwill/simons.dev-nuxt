---
import Layout from "../layouts/Layout.astro";
import ProjectList from "../components/ProjectList.astro";
import { getCollection, getEntry, render } from "astro:content";
import { entryTitle, formatDate, isPublished } from "../lib/entries";
import { toAvif } from "../lib/avif";
import { works } from "../data/studio";
const page = (await getEntry("pages", "index"))!;
const { Content } = await render(page);
const entries = await getCollection("content", entry => isPublished(entry) && entry.id.startsWith("projects/") && (entry.data.featured === true || works.some(work => work.href === `/${entry.id}`)));
const projects = entries.map(entry => {
  const selected = works.find(work => work.href === `/${entry.id}`);
  return {
    slug: entry.id,
    title: selected?.title ?? entryTitle(entry),
    date: selected?.year ?? formatDate(entry.data.date),
    tags: entry.data.tags ?? [],
    image: selected?.image ?? (entry.data.image ? toAvif(entry.data.image) : null),
    description: selected?.description ?? entry.data.description ?? null,
    selected: Boolean(selected),
    sortDate: entry.data.date?.getTime() ?? 0,
  };
}).sort((a, b) => {
  const position = (slug: string) => works.findIndex(work => work.href === `/${slug}`);
  if (a.selected && b.selected) return position(a.slug) - position(b.slug);
  return Number(b.selected) - Number(a.selected) || b.sortDate - a.sortDate;
});
const tags = [...new Set(projects.flatMap(project => project.tags))].sort();
---
<Layout title={page.data.title} description={page.data.description}>
  <section class="shell feed-intro"><div><span class="eyebrow">{page.data.eyebrow}</span><Content /></div><a class="text-link" href="/studio">{page.data.studioLink}</a></section>
  <section class="shell selected-section" aria-labelledby="index-heading"><div class="section-heading"><h2 id="index-heading">Index</h2></div><ProjectList projects={projects} tags={tags} /></section>
</Layout>
