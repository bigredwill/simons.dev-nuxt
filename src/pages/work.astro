---
import Layout from "../layouts/Layout.astro";
import WorkSelection from "../components/WorkSelection.astro";
---

<Layout
  title="Work"
  description="Selected objects, software, installations, and gatherings from Simons Development Labs."
>
  <section class="shell page-intro">
    <span class="eyebrow">An evolving collection / 01–06</span>
    <h1>Work in many forms.</h1>
    <p>
      Some work needs to be held, walked into, or skated. Other work belongs on
      a screen.
    </p>
  </section>
  <section class="shell selected-section">
    <WorkSelection />
    <a class="text-link archive-link" href="/projects">
      Browse the project archive ↗
    </a>
  </section>
</Layout>
