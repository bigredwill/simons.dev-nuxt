---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectGrid from "../components/ProjectGrid";
import type { ProjectItem } from "../components/ProjectGrid";
import { entryTitle, formatDate } from "../lib/entries";
import { toAvif } from "../lib/avif";

const entries = await getCollection(
  "content",
  (entry) => entry.id.startsWith("projects/") && entry.data.featured === true,
);

const projects: ProjectItem[] = entries
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .map((entry) => ({
    slug: entry.id,
    title: entryTitle(entry),
    date: formatDate(entry.data.date),
    tags: entry.data.tags ?? [],
    image: entry.data.image ? toAvif(entry.data.image) : null,
    description: entry.data.description ?? null,
  }));

const tags = [...new Set(projects.flatMap((p) => p.tags))].sort();
---

<Layout
  title="Projects"
  description="Some projects I've documented. Code, art, and more."
>
  <section class="w-full px-4 py-6 sm:px-6">
    <h1 class="mb-1 text-3xl sm:text-4xl">Projects</h1>
    <p class="mb-5 max-w-2xl text-sm text-muted">
      Some projects I've documented. Code, art, and more.
    </p>
    <ProjectGrid client:load projects={projects} tags={tags} />
  </section>
</Layout>
