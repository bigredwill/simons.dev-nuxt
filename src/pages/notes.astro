---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { entryTitle, formatDate, isPublished } from "../lib/entries";
const page = (await getEntry("pages", "notes"))!;
const { Content } = await render(page);
const posts = (await getCollection("content", entry => isPublished(entry) && (entry.id.startsWith("posts/") || entry.id.startsWith("notes/")))).sort((a,b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
---
<Layout title={page.data.title} description={page.data.description}>
  <section class="shell page-intro"><span class="eyebrow">{page.data.eyebrow}</span><Content /></section>
  <section class="shell note-list">
    <div class="feed-list">
      {posts.map(post => <a data-entry class="feed-row" href={`/${post.id}`}><span class="feed-placeholder" aria-hidden="true">↳</span><div class="feed-copy"><h3>{entryTitle(post)}</h3><div class="feed-meta">{formatDate(post.data.date) ?? "From the archive"}</div><p>{post.data.description ?? "A note from Will’s personal archive."}</p></div><span class="feed-kind">note ↗</span></a>)}
    </div>
  </section>
</Layout>
