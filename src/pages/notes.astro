---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { entryTitle, formatDate, isPublished } from "../lib/entries";
const posts = (await getCollection("content", entry => isPublished(entry) && entry.id.startsWith("posts/"))).sort((a,b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
---
<Layout title="Notes" description="Observations, questions, and work in progress from the studio.">
  <section class="shell page-intro"><span class="eyebrow">From the workbench</span><h1>Loose threads.</h1><p>Questions, observations, and things still taking shape. A place to think out loud without having the whole answer.</p></section>
  <section class="shell note-list">
    <div class="feed-list">
      <a data-entry class="feed-row" href="/notes/studio-works"><span class="feed-placeholder" aria-hidden="true">↳</span><div class="feed-copy"><h3>What should I make?</h3><div class="feed-meta">October 2026 · Studio journal</div><p>Beginning STUDIO WORKS, and looking for the ideas I want to keep working on.</p></div><span class="feed-kind">note ↗</span></a>
      {posts.map(post => <a data-entry class="feed-row" href={`/${post.id}`}><span class="feed-placeholder" aria-hidden="true">↳</span><div class="feed-copy"><h3>{entryTitle(post)}</h3><div class="feed-meta">{formatDate(post.data.date) ?? "From the archive"}</div><p>{post.data.description ?? "A note from Will’s personal archive."}</p></div><span class="feed-kind">note ↗</span></a>)}
    </div>
  </section>
</Layout>
