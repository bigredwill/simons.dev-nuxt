---
import Layout from "../layouts/Layout.astro";
import { resume } from "../data/resume";
---
<Layout title="Will Simons — Resume" description="Will Simons, solo founder and software engineer. Experience, selected work, and a printable one-page resume.">
  <div class="resume-controls shell"><a href="/studio">← Studio</a><a href="/resume/will-simons-resume.pdf" download>Download PDF ↓</a><button id="print-resume" type="button" hidden>Print / Save PDF ↗</button><p>One-page layout for Letter or A4. Turn off browser headers and footers when printing.</p></div>
  <article class="resume-sheet">
    <header class="resume-heading"><h1>{resume.name}</h1><p class="resume-title">{resume.title}</p><p class="resume-contact">{resume.location} · <a href={`mailto:${resume.email}`}>{resume.email}</a> · <a href="https://simons.dev">simons.dev</a> · <a href="https://github.com/bigredwill">github.com/bigredwill</a></p></header>
    <p class="resume-summary">{resume.summary}</p>
    <section><h2>Experience</h2>{resume.experience.map(job => <section class="resume-job"><div class="job-heading"><h3>{job.href ? <a href={job.href}>{job.company}</a> : job.company}<span> · {job.role}</span></h3><p>{job.dates}</p></div><ul>{job.bullets.map(bullet => <li>{bullet}</li>)}</ul></section>)}</section>
    <section class="resume-skills"><h2>Skills</h2><p>{resume.skills}</p></section>
    <section><h2>Education</h2><p>{resume.education}</p></section>
  </article>
</Layout>
<script>
  const button = document.querySelector<HTMLButtonElement>("#print-resume");
  if (button) { button.hidden = false; button.addEventListener("click", () => window.print()); }
</script>
<style>
  .resume-controls { padding-block: 28px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 14px; }
  .resume-controls p { width: 100%; font-size: 12px; color: var(--color-muted); }
  button { cursor: pointer; border: 1px solid var(--color-line); background: var(--color-surface); color: var(--color-ink); padding: 10px 14px; }
  .resume-sheet { max-width: 900px; margin: 0 auto 70px; padding: 42px; border: 1px solid color-mix(in srgb, var(--color-line) 25%, transparent); background: var(--color-bg); font: 14px/1.45 Arial, Helvetica, sans-serif; }
  .resume-sheet h1, .resume-sheet h2, .resume-sheet h3 { font-family: Arial, Helvetica, sans-serif; text-transform: none; text-shadow: none; color: var(--color-ink); letter-spacing: 0; font-weight: 700; }
  .resume-sheet h1 { font-size: 30px; margin: 0; }
  .resume-title { font-size: 17px; margin: 4px 0 12px; }
  .resume-contact { font-size: 12px; margin-bottom: 16px; }
  .resume-sheet h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .12em; margin: 20px 0 10px; border-bottom: 1px solid var(--color-line); padding-bottom: 5px; }
  .job-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; }
  .job-heading h3 { font-size: 14px; margin: 0; }
  .job-heading h3 span { font-weight: 400; }
  .job-heading p { font-size: 12px; white-space: nowrap; margin: 0; }
  .resume-job { margin-bottom: 14px; }
  ul { list-style: disc; padding-left: 18px; margin: 7px 0; }
  li { margin-bottom: 4px; }
  .resume-sheet a { color: inherit; text-decoration: none; }
  .resume-sheet a:hover { text-decoration: underline; }
  @media (max-width: 700px) { .resume-sheet { margin-inline: 18px; padding: 24px; } .job-heading { flex-direction: column; gap: 4px; } }
  @media print {
    @page { size: auto; margin: 12mm; }
    :global(html), :global(body) { background: white !important; color: #161616 !important; min-height: 0 !important; color-scheme: light; }
    :global(.studio-header), :global(.studio-footer), .resume-controls { display: none !important; }
    :global(main) { flex: none !important; }
    .resume-sheet { max-width: none; margin: 0; padding: 0; border: 0; background: white; color: #161616; font-size: 10pt; line-height: 1.3; }
    .resume-sheet h1, .resume-sheet h2, .resume-sheet h3 { color: #161616; }
    .resume-sheet h1 { font-size: 24pt; }
    .resume-title { font-size: 12pt; margin: 3px 0 8px; }
    .resume-contact { font-size: 8.5pt; margin-bottom: 10px; }
    .resume-summary { margin-bottom: 10px; }
    .resume-sheet h2 { font-size: 9pt; margin: 13px 0 7px; padding-bottom: 3px; border-color: #777; }
    .job-heading { flex-direction: row; gap: 10px; }
    .job-heading h3 { font-size: 10pt; }
    .job-heading p { font-size: 8.5pt; }
    .resume-job { break-inside: avoid; margin-bottom: 10px; }
    ul { margin: 5px 0; }
    li { margin-bottom: 3px; }
  }
</style>
