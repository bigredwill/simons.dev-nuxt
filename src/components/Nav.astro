---
const links = [
  { href: "/about", label: "About Me" },
  { href: "/projects", label: "Projects" },
  { href: "/now", label: "Now" },
];

const current = Astro.url.pathname.replace(/\/$/, "");
---

<header class="border-b border-line/20">
  <nav
    class="mx-auto flex w-full items-baseline justify-between gap-4 px-4 py-2.5 sm:px-6"
  >
    <a
      href="/"
      class="font-display text-xl lowercase text-ink no-underline"
      style="text-shadow: 2px 2px 0 var(--color-salmon);"
    >
      Will Simons
    </a>
    <ul class="m-0 flex list-none gap-4 p-0 sm:gap-6">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                "font-mono text-[11px] uppercase tracking-[0.15em] no-underline transition-colors duration-150",
                current === href
                  ? "text-salmon-deep"
                  : "text-muted hover:text-salmon-deep",
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
